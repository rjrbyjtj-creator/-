{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Madar Robo",
  "version": "0.2.0",
  "identifier": "ir.madar.robo.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "مدار | روبو",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https: data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; connect-src https: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "نسخه دسکتاپ گفت‌وگوی روبو",
    "category": "Education"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0NkUyN0YyQzZDQ0JCRjYKUldUMnU4ekc4aWR1QkE0R2kvcTRxaURMOVFBVTk0TVBNdnllQzY0MXJFd2NsUzdyOEpQVEVUUGkK",
      "endpoints": [
        "https://github.com/rjrbyjtj-creator/-/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
